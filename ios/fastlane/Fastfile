default_platform(:ios)

platform :ios do
  desc "Compile et envoie le build sur App Store Connect / TestFlight"
  lane :release do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"),
      in_house: false
    )

    keychain_name = ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain")
    keychain_password = ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")

    import_certificate(
      certificate_path: ENV.fetch("P12_PATH"),
      certificate_password: ENV.fetch("P12_PASSWORD"),
      keychain_path: keychain_path,
      keychain_password: keychain_password
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.allinrent.app"
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_info_plist(
      xcodeproj: "ALLINRENT.xcodeproj",
      plist_path: "ALLINRENT/Info.plist",
      block: lambda do |plist|
        plist["CFBundleVersion"] = "21"
        plist["CFBundleShortVersionString"] = "1.0.1"
      end
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ALLINRENT.xcodeproj",
      team_id: "59GW7X6RA6",
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: "com.allinrent.app",
      targets: ["ALLINRENT"]
    )

    build_app(
      project: "ALLINRENT.xcodeproj",
      scheme: "ALLINRENT",
      configuration: "Release",
      export_method: "app-store",
      destination: "generic/platform=iOS",
      skip_profile_detection: true,
      xcargs: "CURRENT_PROJECT_VERSION=21 MARKETING_VERSION=1.0.1",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: "59GW7X6RA6",
        provisioningProfiles: {
          "com.allinrent.app" => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
