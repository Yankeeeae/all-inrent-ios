default_platform(:ios)

APP_ID = "com.allinrent.app"
APP_NUMERIC_ID = "6813145770"
TEAM_ID = "59GW7X6RA6"
VERSION = "1.0.4"
BUILD = "29"

def connect_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"),
    in_house: false
  )
end

def spaceship_login!
  require "spaceship"
  require "json"
  require "uri"
  token = Spaceship::ConnectAPI::Token.create(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH")
  )
  Spaceship::ConnectAPI.token = token
  Spaceship::ConnectAPI.client
end

def ensure_free_pricing!
  client = spaceship_login!
  territories = []
  params = { limit: 200 }
  loop do
    res = client.get("territories", params)
    body = res.is_a?(Hash) ? res : JSON.parse(res.body)
    territories.concat(Array(body["data"]).map { |row| row["id"] })
    nxt = body.dig("links", "next")
    break unless nxt
    params = { limit: 200, "page[cursor]" => URI.decode_www_form(URI(nxt).query || "").to_h["cursor"] || nxt }
    break if territories.size > 500
  end
  territories.uniq!
  UI.message("Territoires App Store: #{territories.size}")

  begin
    client.post("appAvailabilities", {
      data: {
        type: "appAvailabilities",
        attributes: { availableInNewTerritories: true },
        relationships: {
          app: { data: { type: "apps", id: APP_NUMERIC_ID } },
          availableTerritories: {
            data: territories.map { |id| { type: "territories", id: id } }
          }
        }
      }
    })
    UI.success("Disponibilité mondiale enregistrée")
  rescue => error
    UI.important("Disponibilité: #{error.message}")
  end

  points_res = client.get("apps/#{APP_NUMERIC_ID}/appPricePoints", { "filter[territory]" => "FRA", limit: 200 })
  points_body = points_res.is_a?(Hash) ? points_res : JSON.parse(points_res.body)
  free = Array(points_body["data"]).find do |point|
    price = point.dig("attributes", "customerPrice").to_s.tr(",", ".")
    price == "0" || price == "0.0" || price == "0.00"
  end
  UI.user_error!("Aucun palier gratuit trouvé pour FRA") unless free
  UI.message("Price point gratuit: #{free['id']}")

  begin
    client.post("appPriceSchedules", {
      data: {
        type: "appPriceSchedules",
        relationships: {
          app: { data: { type: "apps", id: APP_NUMERIC_ID } },
          baseTerritory: { data: { type: "territories", id: "FRA" } },
          manualPrices: { data: [{ type: "appPrices", id: "${price0}" }] }
        }
      },
      included: [
        {
          type: "appPrices",
          id: "${price0}",
          attributes: { startDate: nil },
          relationships: {
            appPricePoint: { data: { type: "appPricePoints", id: free["id"] } }
          }
        }
      ]
    })
    UI.success("Tarif gratuit enregistré")
  rescue => error
    UI.important("Tarif: #{error.message}")
  end
end

platform :ios do
  desc "Compile et envoie le build sur App Store Connect / TestFlight, puis soumet à la review"
  lane :release do
    setup_ci
    api_key = connect_api_key

    keychain_name = ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain")
    keychain_password = ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")

    import_certificate(
      certificate_path: ENV.fetch("P12_PATH"),
      certificate_password: ENV.fetch("P12_PASSWORD"),
      keychain_path: keychain_path,
      keychain_password: keychain_password
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_ID
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_info_plist(
      xcodeproj: "ALLINRENT.xcodeproj",
      plist_path: "ALLINRENT/Info.plist",
      block: lambda do |plist|
        plist["CFBundleVersion"] = BUILD
        plist["CFBundleShortVersionString"] = VERSION
      end
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ALLINRENT.xcodeproj",
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: APP_ID,
      targets: ["ALLINRENT"]
    )

    build_app(
      project: "ALLINRENT.xcodeproj",
      scheme: "ALLINRENT",
      configuration: "Release",
      export_method: "app-store",
      destination: "generic/platform=iOS",
      skip_profile_detection: true,
      xcargs: "CURRENT_PROJECT_VERSION=#{BUILD} MARKETING_VERSION=#{VERSION}",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: {
          APP_ID => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: false,
      changelog: "ALL IN RENT #{VERSION} (#{BUILD}) — recherche, géolocalisation, contact WhatsApp."
    )

    if ENV.fetch("SUBMIT_FOR_REVIEW", "true") == "true"
      submit_review
    end
  end

  desc "Envoie la fiche App Store et soumet le dernier build à la review"
  lane :submit_review do
    api_key = connect_api_key
    rating_path = [
      File.expand_path("fastlane/rating.json"),
      File.expand_path("rating.json"),
      File.expand_path("ios/fastlane/rating.json"),
      File.expand_path("ios/rating.json")
    ].find { |path| File.exist?(path) }
    UI.user_error!("rating.json introuvable") unless rating_path
    UI.message("Age rating file: #{rating_path}")
    ensure_free_pricing!

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_ID,
      app_version: VERSION,
      app_rating_config_path: rating_path,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: true,
      force: true,
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        add_id_info_serves_ads: false,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: false,
        add_id_info_limits_tracking: false,
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: false,
        export_compliance_encryption_updated: false,
        content_rights_has_rights: true,
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Affiche l'état App Store Connect"
  lane :status do
    api_key = connect_api_key
    require "spaceship"
    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH")
    )
    Spaceship::ConnectAPI.token = token
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} introuvable sur App Store Connect") unless app
    UI.success("App: #{app.name} id=#{app.id} bundle=#{app.bundle_id}")
    versions = Spaceship::ConnectAPI.get_app_store_versions(
      app_id: app.id,
      filter: { platform: "IOS" },
      includes: "appStoreVersionSubmission",
      limit: 5
    )
    versions.each do |v|
      UI.message("Version #{v.version_string} state=#{v.app_store_state} id=#{v.id}")
    end
    builds = Spaceship::ConnectAPI.get_builds(
      filter: { app: app.id, expired: false, processingState: "VALID" },
      sort: "-uploadedDate",
      limit: 5
    )
    builds.each do |b|
      UI.message("Build #{b.version} processing=#{b.processing_state} uploaded=#{b.uploaded_date}")
    end
  end
end
